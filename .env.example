# SOC Handover Platform — 환경설정 예시
# 실제 운영값은 install.ps1 이 .env 로 생성합니다. 이 파일에는 비밀값을 넣지 마십시오.

# ---------- 기본 ----------
APP_ENV=prod              # dev | prod | test
APP_HOST=0.0.0.0          # 내부망 전체 공개 시 0.0.0.0, 단독 PC면 127.0.0.1
APP_PORT=8080
ENABLE_DOCS=false         # 운영에서는 false 권장

# ---------- 보안 ----------
# SECRET_KEY 는 install.ps1 이 64byte 난수로 생성합니다. 비워두면 운영 모드에서 기동되지 않습니다.
SECRET_KEY=
# VAULT_KEY: 장비 비밀번호 보관용 암호화 키(base64 32바이트). 설치 프로그램이 만들어 넣습니다.
# 개발에서는 비워 두면 SECRET_KEY 에서 만들어 쓰고, 운영(APP_ENV=prod)에서는 없으면 그 기능만 꺼집니다.
# 이 값을 잃으면 보관된 비밀번호를 되살릴 수 없습니다(DB 백업에는 암호문만 들어갑니다).
VAULT_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=12
COOKIE_SECURE=false       # HTTPS 사용 시 true
# SSL_CERTFILE=C:\certs\soc.crt
# SSL_KEYFILE=C:\certs\soc.key
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=5

# ---------- 데이터베이스 ----------
# 운영(권장)
# DATABASE_URL=postgresql+psycopg://soc_app:비밀번호@127.0.0.1:5432/soc_handover
# 개발/평가용(PostgreSQL 미설치 시 자동 사용)
# DATABASE_URL=sqlite+pysqlite:///C:/경로/soc-handover/data/soc_handover.db
DATABASE_URL=

# ---------- 경로 ----------
# DATA_DIR=D:\soc-handover-data     # OneDrive 동기화 폴더 밖을 권장
# BACKUP_DIR=
# LOG_DIR=

# ---------- 한도 ----------
EXPORT_MAX_ROWS=100000
UPLOAD_MAX_MB=20

# ---------- 런타임 경로(자동 탐지 실패 시에만) ----------
# PYTHON_EXE=
# NODE_EXE=
